# Keep the build context small and reproducible: never ship local state, and
# let the image build frontend/dist and the venv from scratch.
.git/
.github/
.claude/
.venv/
**/node_modules/
**/__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
frontend/dist/
tests/
config.local.*
.env
.env.*
.DS_Store
