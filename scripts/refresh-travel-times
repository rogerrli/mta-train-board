#!/usr/bin/env python3
"""Re-download the MTA GTFS static feed and rebuild the vendored travel-times data.

Run it with uv so httpx (and the app package) are importable:

    uv run scripts/refresh-travel-times

This downloads the ~5 MB GTFS static subway zip, trims it to the routes in your
active config (config.local.toml, else config.example.toml), and writes the
compact vendored artifact app/data/travel_times.json.gz (used by app/travel.py).
Commit the updated artifact afterwards if it changed.
"""

from app.config import load_config
from app.travel import STATIC_GTFS_URL, refresh_vendored_travel_times


def main() -> int:
    config = load_config()
    routes = {line for station in config.get("stations", []) for line in station.get("lines", [])}
    if not routes:
        print("No routes found in config; nothing to build.")
        return 1

    print(f"Downloading MTA GTFS static feed from {STATIC_GTFS_URL} ...")
    print(f"Trimming to routes: {sorted(routes)}")
    path = refresh_vendored_travel_times(routes)
    print(f"Wrote {path} ({path.stat().st_size} bytes).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
