# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*

# Local config that may hold personal data
config.local.*

# Caches / downloaded GTFS static data
.cache/
data/gtfs-static/

# Frontend (Vite/Svelte). Built assets (frontend/dist) are already covered by the
# dist/ rule above; the Pi builds them at deploy time (npm ci && npm run build).
node_modules/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Git worktrees created by AI coding sessions (local machine state, not project content)
.claude/worktrees/
